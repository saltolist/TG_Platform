{
  "name": "tg-platform",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w tg-platform-frontend",
    "build": "npm run build -w tg-platform-frontend",
    "build:demo": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/TG_Platform NEXT_PUBLIC_USE_MSW=1 npm run build -w tg-platform-frontend",
    "start": "npm run start -w tg-platform-frontend",
    "check": "npm run check --workspaces --if-present"
  },
  "overrides": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@emnapi/wasi-threads": "1.2.2",
    "@tiptap/core": "3.27.2",
    "@tiptap/pm": "3.27.2",
    "@tiptap/react": "3.27.2",
    "@tiptap/extension-bold": "3.27.2",
    "@tiptap/extension-italic": "3.27.2",
    "@tiptap/extension-underline": "3.27.2",
    "@tiptap/extension-strike": "3.27.2",
    "@tiptap/extension-code": "3.27.2",
    "@tiptap/extension-link": "3.27.2",
    "@tiptap/extension-document": "3.27.2",
    "@tiptap/extension-paragraph": "3.27.2",
    "@tiptap/extension-text": "3.27.2",
    "@tiptap/extension-hard-break": "3.27.2",
    "@tiptap/extension-history": "3.27.2",
    "@tiptap/extension-placeholder": "3.27.2"
  }
}
