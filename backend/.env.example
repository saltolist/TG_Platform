# --- Database ---
DATABASE_URL=postgresql+asyncpg://tg:tg@localhost:5432/tg

# pytest only — never point tests at `tg` (conftest wipes users after each test)
TEST_DATABASE_URL=postgresql+asyncpg://tg:tg@localhost:5432/tg_test

# --- Auth / JWT ---
JWT_SECRET=change-me-please-generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080            # 7 days

# --- Auth cookie (httpOnly JWT for browser clients) ---
# localhost: COOKIE_SECURE=0, COOKIE_SAMESITE=lax, COOKIE_DOMAIN empty
# cross-origin prod: COOKIE_SECURE=1, COOKIE_SAMESITE=none, COOKIE_DOMAIN=.example.com
JWT_COOKIE_NAME=access_token
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- CORS (comma-separated browser origins of the frontend) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3020,http://localhost:3021

# --- Email codes (registration / password reset) ---
# If SMTP_HOST is empty, codes are written to the backend logs (dev mode).
EMAIL_CODE_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tg-platform.local

# --- Object storage (MinIO / S3) — used from Phase 2 ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tg-media

# --- Local media for Telegram import (Phase 3, step 3) ---
MEDIA_STORAGE_ROOT=media
MEDIA_PUBLIC_BASE_URL=http://localhost:8000
TELEGRAM_IMPORT_POST_LIMIT=200
TELEGRAM_IMPORT_MAX_MEDIA_MB=20
TELEGRAM_IMPORT_TIMEOUT_SECONDS=600
# MTProto RPC timeout (connect, resolve channel, etc.)
TELEGRAM_RPC_TIMEOUT_SECONDS=60
TELEGRAM_LISTENER_STOP_TIMEOUT_SECONDS=35
# Pre-seed Telethon time_offset from HTTP (fixes Docker macOS clock skew >30s)
TELEGRAM_CLOCK_SYNC_ENABLED=1
# Live-sync: set to 1 only when backend can reach Telegram (VPN/proxy). Default off in Docker.
TELEGRAM_LIVE_SYNC_ENABLED=0
# If Telegram MTProto is blocked, route through local VPN SOCKS (Clash/V2Ray often use 7890/1080).
# From Docker use host.docker.internal instead of 127.0.0.1
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=host.docker.internal
# TELEGRAM_PROXY_PORT=7890

# Live-sync (Telethon events) — API replicas: 0 (use sync-worker); single-process dev: 1
TELEGRAM_LIVE_SYNC_ENABLED=0
# Fan-out sync revision SSE to all API replicas via Redis pub/sub
TELEGRAM_SYNC_EVENTS_REDIS_ENABLED=1
TELEGRAM_LIVE_SYNC_REGISTRY_REFRESH_SECONDS=30
TELEGRAM_LIVE_SYNC_RECONNECT_SECONDS=15
TELEGRAM_CHANNEL_MAINTENANCE_SECONDS=300
# Background catch-up + metrics only (no automatic window reconcile — use manual «Сверить» in profile)
# 0 = disabled (maintenance already catch-up); recommend 30+ for local dev without Docker
TELEGRAM_LIVE_SYNC_FAST_POLL_SECONDS=30
TELEGRAM_ALBUM_DEBOUNCE_SECONDS=2
# Live discussion comments (0 = lazy pull only via sync-comments / open tab)
TELEGRAM_LIVE_COMMENTS_ENABLED=1
# Metrics poll: batch refresh views/reactions on recent posts (seconds / window size)
TELEGRAM_METRICS_POLL_SECONDS=15
TELEGRAM_METRICS_POLL_WINDOW=20
TELEGRAM_METRICS_MIN_SYNC_SECONDS=5
# Background reconcile skips comment pulls (manual reconcile still pulls comments)
TELEGRAM_RECONCILE_INCLUDE_COMMENTS=0
# Paginated discussion comment pulls (sync-comments / manual reconcile)
TELEGRAM_COMMENTS_PULL_PAGE_SIZE=200
TELEGRAM_COMMENTS_PULL_MAX_PAGES=10

# --- Celery / Redis (Phase 3, step 4b) — scheduled publish only ---
# Docker: overridden to redis://redis:6379/0 by docker-compose.yml.
REDIS_URL=redis://localhost:6379/0
TELEGRAM_PUBLISH_MAX_RETRIES=3

# --- BYOK key encryption (Phase 2, step 5) ---
# Generate: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Docker: set in repo root .env (see ../.env.example). Empty = plaintext (dev/test only).
BYOK_ENCRYPTION_KEY=
# Key rotation: comma-separated OLD Fernet keys (decryption only during rotation).
# Run scripts/rotate_byok_key.py then clear this field.
BYOK_ENCRYPTION_OLD_KEYS=

# --- AI (Phase 2) — optional; leave empty for stub replies in presentation/demo ---
# Local backend: keys are read from this file. Docker: use root .env (see repo .env.example).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Web-search providers:
#   OpenAI responses-api + web_search tool (requires OpenAI LLM)
#   Perplexity Search API / sonar models (standalone or built-in)
PERPLEXITY_API_KEY=
# RAG: 0 = off, 1 = on (requires pgvector image and a real LLM model on the account)
RAG_ENABLED=1
# RAG parameters (optional overrides)
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.38
RAG_MAX_NOTE_CHARS=4000
RAG_SEMANTIC_SUMMARIES_ENABLED=1
RAG_SEMANTIC_SUMMARY_TIMEOUT_SECONDS=20
RAG_SEMANTIC_SUMMARY_INPUT_CHARS=6000
# RAG query: prepend recent dialogue turns to the embedding query (0 = current message only)
RAG_QUERY_HISTORY_TURNS=2
RAG_QUERY_MAX_CHARS=2000
# When retrieval misses, rewrite the query via LLM and retry once (0 = off, 1 = on)
RAG_QUERY_REWRITE_ON_MISS=1
# L0 gate: skip RAG for greetings/acks and style-edit requests (0 = off, 1 = on)
RAG_L0_ENABLED=1
# Tier A escalation thresholds (diagnostics until Step 1.4+)
RAG_ESCALATE_MIN_SIMILARITY=0.72
RAG_ESCALATE_ON_MISS=1
# Tier B LLM sufficiency check (0 = off until Step 1.5 consumes verdict)
RAG_TIER_B_ENABLED=0
# L2 agentic loop mode: off (default, until rollout) | flat | agentic | auto
RAG_MODE=off
RAG_AGENT_MAX_STEPS=4
RAG_AGENT_MAX_VISION=2
# L2 structured planning before tool loop: off | auto (default) | always
RAG_AGENT_PLANNING_MODE=auto
# L2 plan alignment: optional LLM auditor after deterministic pre-flight (0 = off)
RAG_AGENT_PLAN_ALIGNMENT_LLM=0
AGENT_RUNTIME_PHASE1_ENABLED=1
AGENT_TURN_CONTRACT_V2_ENABLED=1
# Route exhaustive inventory to the durable agent-batch queue.
AGENT_BATCH_PATH_V1_ENABLED=1
# Celery prefork metrics (set before importing prometheus_client).
# Give each worker container its own local directory; never share this path
# between containers with independent PID namespaces.
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
# PROMETHEUS_METRICS_PORT=9108
RAG_INTENT_ROUTING_ENABLED=0
# Small similarity boost for the chat's home scope in cross-scope retrieval (0.03–0.05).
RAG_SCOPE_BIAS=0.04
# Embeddings: local model by default (no key needed).
# Set EMBEDDING_PROVIDER_BYOK=OpenAI to use BYOK OpenAI embeddings instead.
EMBEDDING_MODEL_LOCAL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Docker: baked into the image at build time; local dev uses ~/.cache or /tmp by default.
# FASTEMBED_CACHE_PATH=/app/.cache/fastembed
EMBEDDING_PROVIDER_BYOK=
# LLM debug: AI_CONTEXT_LOG=1 logs every turn into an in-memory buffer (no filter needed).
# Terminal tail: ./scripts/ai-log-chat.sh <chat-id>
# Past turns (incl. first message): GET /api/v1/dev/ai-context-log/traces?chatId=<id>
AI_CONTEXT_LOG=1
AI_CONTEXT_LOG_CHAT=
# v2 contextStamp: 0 = legacy labels (6.1-0.0-1), 1 = msg-ver-branch + contextStamp JSON
AI_CONTEXT_STAMPS=0
AGENT_ADAPTIVE_EVIDENCE_DEPTH_V1_ENABLED=0
